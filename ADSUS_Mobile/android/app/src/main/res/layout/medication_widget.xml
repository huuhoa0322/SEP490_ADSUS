<?xml version="1.0" encoding="utf-8"?>
<!--
  ADSUS Medication Widget layout — Redesign 2026-09-04.

  Dùng LinearLayout vertical. Widget 4×3 large.

  Mỗi dose row dùng wrap_content + minHeight cố định, vì layout_weight=1 với
  parent wrap_content sẽ collapse về 0.

  RemoteViews whitelist: KHÔNG dùng <View> divider — dùng <TextView> empty thay.
  Vì không thể thay đổi background drawable động theo status trên row (RemoteViews
  không cho phép setBackgroundColor trên LinearLayout), nên status hiển thị bằng
  text color trên text_status_X + teal border-left bằng background của một TextView 4dp
  rộng bên trái mỗi row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    android:orientation="vertical">

    <!-- Header row: pill icon + title + count badge + refresh -->
    <LinearLayout
        android:id="@+id/header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/icon_pill"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_pill"
            android:contentDescription="Thuốc" />

        <TextView
            android:id="@+id/text_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Lịch uống thuốc"
            android:textColor="#1F2A44"
            android:textSize="14sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- Count badge (hiển thị số liều còn nợ) -->
        <TextView
            android:id="@+id/text_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/badge_count_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="Làm mới"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- Divider: dùng TextView thay View vì RemoteViews không cho inflate android.view.View -->
    <TextView
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="6dp"
        android:background="#E0E0E0"
        android:text="" />

    <!-- Dose rows container -->
    <LinearLayout
        android:id="@+id/doses_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Dose row template: border-left 4dp + time teal bold + name + status badge right -->
        <!-- Row 1 -->
        <LinearLayout
            android:id="@+id/dose_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <!-- Status border-left (4dp wide colored strip) -->
            <TextView
                android:id="@+id/border_1"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="#128C82"
                android:text="" />

            <TextView
                android:id="@+id/text_time_1"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#128C82"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_name_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#1F2A44"
                    android:textSize="13sp"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/text_dosage_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:ellipsize="end"
                    android:maxLines="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_status_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:id="@+id/dose_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/border_2"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="#128C82"
                android:text="" />

            <TextView
                android:id="@+id/text_time_2"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#128C82"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_name_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#1F2A44"
                    android:textSize="13sp"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/text_dosage_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:ellipsize="end"
                    android:maxLines="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_status_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:id="@+id/dose_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/border_3"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="#128C82"
                android:text="" />

            <TextView
                android:id="@+id/text_time_3"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#128C82"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_name_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#1F2A44"
                    android:textSize="13sp"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/text_dosage_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:ellipsize="end"
                    android:maxLines="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_status_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout
            android:id="@+id/dose_row_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/border_4"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="#128C82"
                android:text="" />

            <TextView
                android:id="@+id/text_time_4"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#128C82"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_name_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#1F2A44"
                    android:textSize="13sp"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/text_dosage_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:ellipsize="end"
                    android:maxLines="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_status_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- "và X liều khác" footer -->
    <TextView
        android:id="@+id/text_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="#666666"
        android:textSize="11sp"
        android:visibility="gone"
        android:text="và X liều khác" />

    <!-- State message (loading / empty / error / all done / not logged in) -->
    <TextView
        android:id="@+id/state_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#999999"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
