{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/adsus-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "ADSUS_BE",
    "Audience": "ADSUS_Client",
    "ExpiryMinutes": 60
  },
  "AiBackend": {
    "WebhookUrl": "http://localhost:8000",
    "Token": ""
  },
  "SupabaseStorage": {
    "Url": "",
    "ServiceKey": "",
    "Bucket": "ultrasound-images",
    "SignedUrlTtlSeconds": 300
  },
  "ScheduleSettings": {
    "MinAdvanceDaysForLeave": 2,
    "Shifts": {
      "MORNING": { "Start": "08:00", "End": "12:00" },
      "AFTERNOON": { "Start": "13:00", "End": "17:00" },
      "EVENING": { "Start": "17:00", "End": "20:00" }
    }
  }
}
