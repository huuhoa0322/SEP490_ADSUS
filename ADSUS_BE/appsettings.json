{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/adsus-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "ADSUS_BE",
    "Audience": "ADSUS_Client",
    "ExpiryMinutes": 60
  },
  "AiBackend": {
    "WebhookUrl": "http://localhost:8000",
    "Token": ""
  },
  "SupabaseStorage": {
    "Url": "",
    "ServiceKey": "",
    "Bucket": "ultrasound-images",
    "SignedUrlTtlSeconds": 300
  }
}
